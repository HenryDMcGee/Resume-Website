{
  // The Worker's name. This MUST match the name of the Worker you
  // already created in the Cloudflare dashboard. If it doesn't,
  // `wrangler deploy` will create a second, separate Worker.
  "name": "resume-website",

  "compatibility_date": "2026-09-01",

  // Keeps the free *.workers.dev URL alive. Wrangler turns this off
  // by default when it isn't stated explicitly, which silently takes
  // your test URL offline.
  "workers_dev": true,

  // A small script handles /api/* (the feedback page). Everything else
  // is served straight from ./public without running it.
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Feedback responses. No database_id on purpose: wrangler deploy creates
  // the database the first time (automatic provisioning) and keeps it
  // linked after that. The table is created by the script on first use.
  "d1_databases": [
    { "binding": "DB", "database_name": "mcgeehenry-feedback" }
  ],

  // Cloudflare Access guards /insights, /feedback/responses and their APIs.
  // Neither value is a secret. Same Zero Trust team as internship-watch; the
  // AUD is the "Application Audience (AUD) Tag" of the Access app that lists
  // those mcgeehenry.com paths (currently the internship-watch app). Several
  // apps can be allowed by separating their AUD tags with commas.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "royal-band-14be.cloudflareaccess.com",
    "ACCESS_AUD": "0162b88431b5d036e4cbe75aa8999c7e8c48153f72abf818c8002c0440ad367d"
  }
}
